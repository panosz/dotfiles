[papers]
dir = ~/Documents/papis_papers

[settings]

default-library = papers

ask-llm = "openai/gpt-4.1"
ask-summary-llm = "openai/gpt-4.1-mini"
ask-embedding = "openai/text-embedding-3-small"

# use fzf picker
picktool = fzf

# Ask for confirmation when doing papis add ...
add-confirm = True
# Edit the info.yaml file before adding a doc into the library
# papis add --edit
add-edit = True
# Don't download files by default
# papis add --no-download-files
add-download-files = False
# Open the files before adding a document into the library
# papis add --open
add-open = False
# Default folder name for newly added documents
add-folder-name = {doc[author_list][0][family]} - {doc[title]}
# Default file name
add-file-name = {doc[author_list][0][family]} - {doc[title]}

# Run doctor fixes at newly added files
# auto-doctor = True

#bibtex 
bibtex-unicode = False
extra-bibtex-types = ["thesis"]
bibtex-ignore-keys = ["abstract", "extra", "language"]


# preview (recipe from https://github.com/papis/papis/discussions/511#discussioncomment-5206928)
